+    function requestPowerAction(action) {
+        if (action < 0 || action >= powerCommands.length) return
+        if (unlocking || authenticating) return
+        // A half-typed password belongs to the unlock, not to this action.
+        password = ""
+        pendingPowerAction = action
+        pendingPowerTimer.restart()
+    }
+
+    function cancelPowerAction() {
+        pendingPowerAction = -1
+        pendingPowerTimer.stop()
+    }
